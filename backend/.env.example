# Copy to .env and fill in. Never commit .env.

# auto      = use Upstox when connected, otherwise simulated data (labelled in every response)
# upstox    = Upstox only; return an error when not connected
# simulated = generated prices only
DATA_SOURCE=auto

PORT=3000
HOST=127.0.0.1

# From your app on the Upstox developer console.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must match the redirect URL registered on the Upstox app exactly.
UPSTOX_REDIRECT_URI=http://127.0.0.1:3000/auth/upstox/callback

# Optional: paste a token instead of using the login flow. Tokens expire at 3:30 AM IST.
UPSTOX_ACCESS_TOKEN=

# Optional: a browser origin allowed to call /api from another site, e.g. https://your-dashboard.example
ALLOW_ORIGIN=
